{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesloft Account and People Redaction Client Credentials Access Token API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Client Credentials Access Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Salesloft Retrieve Client Credentials Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://{{salesloft_api_base_url}}/oauth/token",
            "params": [
              {
                "name": "client_id",
                "value": "{{client_id}}",
                "type": "query"
              },
              {
                "name": "client_secret",
                "value": "{{client_secret}}",
                "type": "query"
              },
              {
                "name": "grant_type",
                "value": "client_credentials",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "public:all",
                "type": "query"
              }
            ]
          },
          "docs": "Salesloft Retrieve Client Credentials Access Token"
        }
      ]
    }
  ],
  "bundled": true
}